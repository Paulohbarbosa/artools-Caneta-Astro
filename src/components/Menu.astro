---
// Menu Component
const pathname = Astro.url.pathname;
const currentPath = pathname === '/' ? '/' : pathname.replace(/\/$/, '');
---
<header
  id="main-header"
  class="fixed top-0 left-0 w-full z-50 px-6 md:px-12 py-6 flex justify-between items-center hero-element pointer-events-auto bg-white transition-all duration-300"
>
  <a
    class="flex items-center gap-3 text-stone-900 pointer-events-auto cursor-pointer"
    href="#"
  >
    <div
      class="w-7 h-7 bg-stone-900 text-white flex items-center justify-center rounded-sm"
    >
      <iconify-icon icon="solar:pen-bold"></iconify-icon>
    </div>
    <span class="font-display font-bold tracking-tight text-xl"
      >ARTOOLS<span class="text-stone-500 font-light text-[1rem]"
        >.PRO</span
      ></span
    >
  </a>

  <nav
    class="hidden md:flex gap-8 text-[10px] font-mono uppercase tracking-[0.15em] text-stone-500 pointer-events-auto items-center"
  >
    <a
      href="/"
      class={`hover:text-stone-900 transition-colors duration-300 font-bold py-1 ${currentPath === '/' ? 'text-stone-900 border-b-2 border-stone-900' : ''}`}
      >Início</a
    >
    <a
      href="/catalogo"
      class={`hover:text-stone-900 transition-colors duration-300 font-bold py-1 ${currentPath === '/catalogo' ? 'text-stone-900 border-b-2 border-stone-900' : ''}`}
      >Catálogo</a
    >
    <a
      href="/#tech-specs"
      class={`hover:text-stone-900 transition-colors duration-300 ${currentPath === '/#tech-specs' ? 'text-stone-900 border-b-2 border-stone-900' : ''}`}
      >Especificações</a
    >
    <a
      href="/#design"
      class=`hover:text-stone-900 transition-colors duration-300 ${currentPath === '/#design' ? 'text-stone-900 border-b-2 border-stone-900' : ''}`
      >Design</a
    >
    <a
      href="/#buy"
      class={`hover:text-stone-900 transition-colors duration-300 ${currentPath === '/#buy' ? 'text-stone-900 border-b-2 border-stone-900' : ''}`}
      >Comprar</a
    >
  </nav>

  <div class="flex items-center gap-6 text-stone-900 pointer-events-auto">
    <a
      href="/compra"
      class="hover:text-stone-500 transition-colors duration-300 flex items-center justify-center relative"
    >
      <iconify-icon
        icon="solar:bag-3-linear"
        class="text-xl"
      ></iconify-icon>
      <span
        id="menu-cart-count"
        class="absolute -top-1.5 -right-2 bg-stone-900 text-white text-[9px] font-bold w-[18px] h-[18px] rounded-full flex items-center justify-center transition-all duration-300 scale-0"
      >0</span>
    </a>
    <div class="w-[1px] h-4 bg-stone-300 hidden md:block"></div>
  </div>
</header>

<script>
  import { cartItems } from '../store/cartStore';

  document.addEventListener("astro:page-load", () => {
    const menuCartCount = document.getElementById('menu-cart-count');
    
    if (menuCartCount) {
      cartItems.subscribe((cart) => {
        const count = Object.values(cart).reduce((acc, item) => acc + item.quantity, 0);
        menuCartCount.textContent = count.toString();
        
        if (count > 0) {
          menuCartCount.classList.remove('scale-0');
          menuCartCount.classList.add('scale-100');
        } else {
          menuCartCount.classList.remove('scale-100');
          menuCartCount.classList.add('scale-0');
        }
      });
    }
  });
</script>
