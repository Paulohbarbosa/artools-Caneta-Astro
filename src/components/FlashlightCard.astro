---
// src/components/FlashlightCard.astro
// Este componente representa os cards com o efeito de "lanterna" (flashlight) ao passar o mouse.
// Ele foi extraído da página principal para manter o código organizado e reutilizável.

export interface Props {
  title: string; // Título do card
  description: string; // Texto descritivo
  icon: string; // Nome do ícone da biblioteca Iconify (ex: solar:pen-new-square-linear)
  revealDelayClass?: string; // Classe opcional do Tailwind para atraso da animação de surgimento (reveal-up)
  progressDelayClass?: string; // Classe opcional para o atraso da animação da barra de progresso no hover
}

const { 
  title, 
  description, 
  icon, 
  revealDelayClass = '', 
  progressDelayClass = '' 
} = Astro.props;
---

<!-- 
  Container principal do card.
  O atributo onmousemove chama a função global updateFlashlight() para atualizar o efeito de brilho radial seguindo o mouse.
-->
<div
  class={`flashlight-card h-[400px] border border-stone-300 bg-white p-8 flex flex-col justify-between rounded-sm hover:shadow-2xl hover:-translate-y-1 transition-all duration-500 group reveal-up ${revealDelayClass}`}
  onmousemove="updateFlashlight(event, this)"
>
  <!-- Ícone do Card -->
  <!-- Ao fazer hover (group-hover), as cores são invertidas suavemente -->
  <div
    class="w-12 h-12 bg-stone-100 rounded-lg flex items-center justify-center text-stone-900 mb-6 group-hover:bg-stone-900 group-hover:text-white transition-colors duration-500"
  >
    <iconify-icon
      icon={icon}
      class="text-2xl"
    ></iconify-icon>
  </div>
  
  <!-- Conteúdo de Texto -->
  <div>
    <h3 class="text-2xl font-display font-medium mb-3">
      {title}
    </h3>
    <p class="text-stone-500 text-sm leading-relaxed">
      {description}
    </p>
  </div>
  
  <!-- Barra de Progresso no Hover -->
  <!-- O "w-0" vira "w-full" no group-hover preenchendo a barrinha -->
  <div class="h-1 w-full bg-stone-100 mt-8 overflow-hidden">
    <div
      class={`h-full bg-stone-900 w-0 group-hover:w-full transition-all duration-700 ease-out ${progressDelayClass}`}
    ></div>
  </div>
</div>
