---
import Button from './Button.astro';

export interface Props {
  title: string;
  description: string;
  icon: string;
  image: string; // Nova propriedade de imagem
  href: string;
  delay?: string;
}

const { title, description, icon, image, href, delay = '' } = Astro.props;
---
<div class={`bg-white border border-stone-200 flex flex-col justify-between rounded-xl shadow-sm hover:shadow-2xl hover:-translate-y-2 transition-all duration-500 reveal-up overflow-hidden group ${delay}`}>
  <div class="overflow-hidden relative">
    <!-- Imagem de Fundo Fotográfica -->
    <img src={image} alt={title} class="w-full aspect-[4/3] object-cover hover:scale-105 transition-transform duration-700" />
  </div>
  
  <div class="p-6">
    <h3 class="text-2xl font-display font-medium text-stone-900 mb-3">{title}</h3>
    <p class="text-stone-500 text-sm leading-relaxed mb-8">{description}</p>
    <Button variant="primary" href={href} class="w-full flex justify-center">Visualizar</Button>
  </div>
</div>
