---
// src/components/PricingCard.astro
// Este componente encapsula a exibição dos planos de compra/assinatura.
// Ele possui duas variações controladas pela propriedade `isPremium` para manter o código enxuto.

import Button from './Button.astro';

export interface Props {
  isPremium?: boolean; // Define se o card é o de destaque (maior e centralizado)
  title: string; // Título do plano (aceita HTML no caso premium para formatações específicas)
  subtitle: string; // Subtítulo (ex: Apenas a Caneta, Signature Series)
  description?: string; // Descrição longa (apenas para os planos padrão)
  price?: string; // Preço (ex: $89)
  priceUnit?: string; // Unidade (ex: usd, /ano)
  buttonText: string; // Texto do botão
  buttonHref: string; // Link de destino da compra
  icon: string; // Ícone via Iconify
  revealDelayClass?: string; // Classe opcional do Tailwind para o delay da animação (ex: delay-200)
}

const {
  isPremium = false,
  title,
  subtitle,
  description,
  price,
  priceUnit = 'usd',
  buttonText,
  buttonHref,
  icon,
  revealDelayClass = ''
} = Astro.props;
---

{isPremium ? (
  // <!-- Card Premium (Destaque Central) -->
  <div
    class={`bg-[#111111]/90 backdrop-blur-xl border border-white/10 p-10 rounded-2xl flex flex-col justify-center items-center h-[480px] shadow-2xl shadow-black/80 relative transform md:-translate-y-6 hover:scale-[1.02] transition-transform duration-500 reveal-up ${revealDelayClass} w-full`}
  >
    {/* <!-- Glow Effect (brilho difuso no fundo superior direito) --> */}
    <div
      class="absolute -top-10 -right-10 w-40 h-40 bg-white/10 rounded-full blur-3xl pointer-events-none"
    ></div>

    <div
      class="text-center w-full flex-grow flex flex-col justify-center items-center"
    >
      <div
        class="w-12 h-12 bg-white rounded-full flex items-center justify-center text-[#111] mb-6 shadow-lg"
      >
        <iconify-icon
          icon={icon}
          class="text-xl"
        ></iconify-icon>
      </div>

      <h3
        class="text-[2.5rem] font-display text-white mb-6 tracking-tight leading-none"
      >
        <span set:html={title}></span>
      </h3>

      <div class="w-6 h-[1px] bg-stone-600 mb-4"></div>

      <div
        class="text-[9px] font-mono uppercase tracking-[0.3em] text-stone-400 mb-10"
      >
        {subtitle}
      </div>
    </div>

    <div class="w-full mt-auto">
      <Button variant="primary-dark" href={buttonHref}>
        {buttonText}
        <iconify-icon
          icon="solar:arrow-right-linear"
          class="text-lg group-hover:translate-x-1 transition-transform"
        ></iconify-icon>
      </Button>
    </div>
  </div>
) : (
  // <!-- Card Padrão -->
  <div
    class={`bg-[#1c1c1c]/80 backdrop-blur-md border border-white/10 p-8 rounded-2xl flex flex-col justify-between h-[420px] hover:border-white/30 transition-colors reveal-up ${revealDelayClass}`}
  >
    <div>
      <div
        class="w-10 h-10 bg-white/10 rounded-full flex items-center justify-center text-white mb-6"
      >
        <iconify-icon
          icon={icon}
          class="text-xl"
        ></iconify-icon>
      </div>
      <h3 class="text-2xl font-display font-medium text-white mb-2">
        {title}
      </h3>
      <div
        class="text-[10px] font-mono uppercase tracking-widest text-stone-400 mb-6"
      >
        {subtitle}
      </div>
      {description && (
        <p class="text-stone-400 text-sm leading-relaxed mb-8">
          {description}
        </p>
      )}
    </div>
    <div class="mt-auto">
      <div class="text-3xl font-display text-white mb-4">
        {price}<span
          class="text-xs text-stone-500 font-mono ml-1 uppercase"
          >{priceUnit}</span
        >
      </div>
      <Button variant="secondary-dark" href={buttonHref}>
        {buttonText}
      </Button>
    </div>
  </div>
)}
