---
// Footer Component
---
<footer
  class="bg-stone-950 text-stone-400 py-16 border-t border-stone-800 relative z-20"
>
  <div class="container mx-auto px-6 md:px-12">
    <div
      class="grid grid-cols-1 md:grid-cols-4 gap-12 md:gap-8 mb-16 reveal-up"
    >
      <!-- Brand -->
      <div class="md:col-span-1">
        <div class="flex items-center gap-3 text-white mb-6">
          <div
            class="w-7 h-7 bg-white text-stone-900 flex items-center justify-center rounded-sm"
          >
            <iconify-icon icon="solar:pen-bold"></iconify-icon>
          </div>
          <span class="font-display font-bold tracking-tight text-xl"
            >ARTOOLS<span class="text-stone-500 font-light text-[1rem]"
              >.PRO</span
            ></span
          >
        </div>
        <p class="text-sm leading-relaxed max-w-xs">
          A ferramenta invisível para ideias tangíveis. Redefinindo a
          escrita no século 21.
        </p>
      </div>

      <!-- Links -->
      <div>
        <h4 class="text-white font-display font-medium mb-6">Produtos</h4>
        <ul class="space-y-4 text-sm">
          <li>
            <a href="#" class="hover:text-white transition-colors"
              >Precision Pen</a
            >
          </li>
          <li>
            <a href="#" class="hover:text-white transition-colors"
              >Signature Series</a
            >
          </li>
          <li>
            <a href="#" class="hover:text-white transition-colors"
              >Refis de Tinta</a
            >
          </li>
          <li>
            <a href="#" class="hover:text-white transition-colors"
              >Acessórios</a
            >
          </li>
        </ul>
      </div>

      <!-- Suporte -->
      <div>
        <h4 class="text-white font-display font-medium mb-6">Suporte</h4>
        <ul class="space-y-4 text-sm">
          <li>
            <a href="#" class="hover:text-white transition-colors">FAQ</a>
          </li>
          <li>
            <a href="#" class="hover:text-white transition-colors"
              >Garantia Vitalícia</a
            >
          </li>
          <li>
            <a href="#" class="hover:text-white transition-colors"
              >Envio e Devoluções</a
            >
          </li>
          <li>
            <a href="#" class="hover:text-white transition-colors"
              >Contato</a
            >
          </li>
        </ul>
      </div>

      <!-- Social -->
      <div>
        <h4 class="text-white font-display font-medium mb-6">
          Redes Sociais
        </h4>
        <div class="flex gap-4">
          <a
            href="#"
            class="w-10 h-10 rounded-full bg-stone-900 flex items-center justify-center hover:bg-white hover:text-stone-900 transition-colors"
          >
            <iconify-icon
              icon="ri:instagram-line"
              class="text-lg"
            ></iconify-icon>
          </a>
          <a
            href="#"
            class="w-10 h-10 rounded-full bg-stone-900 flex items-center justify-center hover:bg-white hover:text-stone-900 transition-colors"
          >
            <iconify-icon
              icon="ri:twitter-x-line"
              class="text-lg"
            ></iconify-icon>
          </a>
          <a
            href="#"
            class="w-10 h-10 rounded-full bg-stone-900 flex items-center justify-center hover:bg-white hover:text-stone-900 transition-colors"
          >
            <iconify-icon
              icon="ri:youtube-line"
              class="text-lg"
            ></iconify-icon>
          </a>
        </div>
      </div>
    </div>

    <div
      class="border-t border-stone-800 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-xs font-mono reveal-up delay-200"
    >
      <p>&copy; 2026 Artools. Todos os direitos reservados.</p>
      <div class="flex gap-6">
        <a href="#" class="hover:text-white transition-colors"
          >Termos de Uso</a
        >
        <a href="#" class="hover:text-white transition-colors"
          >Privacidade</a
        >
      </div>
    </div>
  </div>
</footer>
