---
// TechSpecs Component
---

<section id="tech-specs" class="bg-black py-24 relative z-20">
  <div class="container mx-auto px-6 md:px-12 max-w-4xl">
    <div class="text-center mb-16 reveal-up">
      <span class="text-xs font-mono uppercase tracking-[0.2em] text-stone-500 mb-4 block">
        Engenharia de Precisão
      </span>
      <h2 class="font-display text-4xl md:text-5xl font-medium tracking-tight text-white">
        Especificações Técnicas
      </h2>
    </div>

    <div class="bg-[#0a0a0a] border border-white/10 rounded-2xl overflow-hidden reveal-up delay-200 shadow-2xl shadow-black">
      <table class="w-full text-left border-collapse">
        <tbody>
          <tr class="border-b border-white/5 hover:bg-white/[0.02] transition-colors">
            <th class="py-6 px-6 md:px-8 font-medium text-white w-1/3">Material do Corpo</th>
            <td class="py-6 px-6 md:px-8 text-stone-400">Alumínio Aeroespacial 6061-T6 anodizado</td>
          </tr>
          <tr class="border-b border-white/5 hover:bg-white/[0.02] transition-colors">
            <th class="py-6 px-6 md:px-8 font-medium text-white">Peso</th>
            <td class="py-6 px-6 md:px-8 text-stone-400">24 gramas (balanceamento perfeito 50/50)</td>
          </tr>
          <tr class="border-b border-white/5 hover:bg-white/[0.02] transition-colors">
            <th class="py-6 px-6 md:px-8 font-medium text-white">Comprimento</th>
            <td class="py-6 px-6 md:px-8 text-stone-400">142 mm</td>
          </tr>
          <tr class="border-b border-white/5 hover:bg-white/[0.02] transition-colors">
            <th class="py-6 px-6 md:px-8 font-medium text-white">Mecanismo</th>
            <td class="py-6 px-6 md:px-8 text-stone-400">Retrátil silencioso com amortecimento a óleo</td>
          </tr>
          <tr class="border-b border-white/5 hover:bg-white/[0.02] transition-colors">
            <th class="py-6 px-6 md:px-8 font-medium text-white">Tipo de Carga</th>
            <td class="py-6 px-6 md:px-8 text-stone-400">Refil Schmidt P900 Parker-style (tinta gel premium inclusa)</td>
          </tr>
          <tr class="border-b border-white/5 hover:bg-white/[0.02] transition-colors">
            <th class="py-6 px-6 md:px-8 font-medium text-white">Acabamento</th>
            <td class="py-6 px-6 md:px-8 text-stone-400">Micro-usinagem a laser (Rugosidade de 0.8µm)</td>
          </tr>
          <tr class="hover:bg-white/[0.02] transition-colors">
            <th class="py-6 px-6 md:px-8 font-medium text-white">Garantia</th>
            <td class="py-6 px-6 md:px-8 text-stone-400">Vitalícia contra defeitos de fabricação</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>
