---
// TechSpecs Component
export interface Props {
  specs?: Record<string, string>;
}

const { specs = {} } = Astro.props;
---

<section id="tech-specs" class="py-24 relative z-20">
  <div class="container mx-auto px-6 md:px-12 max-w-4xl">
    <div class="text-center mb-16 reveal-up">
      <span class="text-xs font-mono uppercase tracking-[0.2em] text-stone-900 mb-4 block">
        Engenharia de Precisão
      </span>
      <h2 class="font-display text-4xl md:text-5xl font-medium tracking-tight text-stone-900">
        Especificações Técnicas
      </h2>
    </div>

    <div class="bg-[#0a0a0a] border border-2px solid border-stone-200 rounded-2xl overflow-hidden reveal-up delay-200">
      <table class="w-full text-left border-collapse">
        <tbody>
          {Object.entries(specs).map(([key, value]) => (
            <tr class="border-b border-white/5 hover:bg-white/[0.02] transition-colors last:border-0">
              <th class="py-6 px-6 md:px-8 font-medium text-white w-1/3">{key}</th>
              <td class="py-6 px-6 md:px-8 text-stone-400">{value}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
