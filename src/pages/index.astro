---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import FlashlightCard from '../components/FlashlightCard.astro';
import PricingCard from '../components/PricingCard.astro';
import Marquee from '../components/Marquee.astro';
// Astro Component
---

<!doctype html>
<html class="scroll-smooth" lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Artools Precision Pen - A caneta mais tecnológica do mundo</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Tailwind & Iconify -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>

    <!-- GSAP & ScrollTrigger -->
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              sans: ["Inter", "sans-serif"],
              mono: ["JetBrains Mono", "monospace"],
              display: ["Space Grotesk", "sans-serif"],
            },
            colors: {
              stone: {
                50: "#fafaf9",
                100: "#f5f5f4",
                200: "#e7e5e4",
                300: "#d6d3d1",
                400: "#a8a29e",
                500: "#78716c",
                600: "#57534e",
                700: "#44403c",
                800: "#292524",
                900: "#1c1917",
              },
              "surface-light": "#EAEAE5",
            },
          },
        },
      };
    </script>

    <style>
      /* Typography Variables & Utilities */
      :root {
        --bg-color: #eaeae5;
        --text-main: #1c1917;
        --text-secondary: #78716c;
      }

      body {
        font-family: "Inter", sans-serif;
        background-color: var(--bg-color);
        color: var(--text-main);
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
      }

      .text-balance {
        text-wrap: balance;
      }

      /* Headline Outline Effect */
      .outline-text {
        color: transparent;
        -webkit-text-stroke: 1.5px var(--text-main);
      }

      /* Initial States for GSAP Animations */
      .hero-element-text {
        transform: translateY(110%);
        visibility: hidden;
      }

      .hero-element {
        opacity: 0;
        visibility: hidden;
      }

      /* Scroll Indicator Animation */
      .scroll-line {
        width: 1px;
        height: 30px;
        background-color: #d6d3d1;
        position: relative;
        overflow: hidden;
      }

      .scroll-line::after {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: var(--text-main);
        animation: scrollLine 1.5s cubic-bezier(0.645, 0.045, 0.355, 1) infinite;
      }

      @keyframes scrollLine {
        0% {
          transform: translateY(-100%);
        }
        100% {
          transform: translateY(100%);
        }
      }

      /* Oculta a scrollbar nativa para criarmos uma customizada perfeita sobre o fundo */
      ::-webkit-scrollbar {
        display: none;
      }
      html {
        scrollbar-width: none; /* Firefox */
      }

      /* Delays Personalizados */
      .delay-100 {
        transition-delay: 0.1s;
      }
      .delay-200 {
        transition-delay: 0.2s;
      }
      .delay-300 {
        transition-delay: 0.3s;
      }
      .delay-400 {
        transition-delay: 0.4s;
      }
      .delay-500 {
        transition-delay: 0.5s;
      }
      .delay-600 {
        transition-delay: 0.6s;
      }
      .delay-700 {
        transition-delay: 0.7s;
      }

      /* Efeito de Lanterna (Hover) */
      .flashlight-card {
        position: relative;
        overflow: hidden;
      }

      .flashlight-card::before {
        content: "";
        position: absolute;
        inset: 0px;
        background: radial-gradient(
          600px circle at var(--mouse-x, 0) var(--mouse-y, 0),
          rgba(255, 255, 255, 0.8),
          transparent 40%
        );
        opacity: 0;
        transition: opacity 0.5s;
        pointer-events: none;
        z-index: 2;
      }

      .flashlight-card:hover::before {
        opacity: 1;
      }

      /* Animações de Revelação (Scroll) */
      .reveal-up {
        opacity: 0;
        transform: translateY(30px);
        filter: blur(15px);
        will-change: transform, opacity, filter;
        transition: all 1.2s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .reveal-up.active {
        opacity: 1;
        transform: translateY(0);
        filter: blur(0);
      }
    </style>
  </head>

  <body
    class="antialiased min-h-screen selection:bg-stone-800 selection:text-white"
  >
    <!-- Indicador de Rolagem Customizado (Flutuante e Transparente) -->
    <div
      id="custom-scrollbar"
      class="fixed right-[5px] top-0 w-[6px] bg-stone-400/50 hover:bg-stone-400/80 rounded-full z-[9999] transition-opacity duration-300 opacity-0 pointer-events-auto cursor-pointer"
    ></div>

    <!-- HEADER (Navigation) -->
    <Header />

    <!-- MAIN SCROLL CONTAINER -->
    <main>
      <!-- HERO SEQUENCE (Pinned Section) -->
      <section
        id="hero-sequence"
        class="relative h-screen w-full overflow-hidden bg-[#EAEAE5]"
      >
        <!-- Camada do Canvas de Imagens (Fundo) -->
        <div class="absolute inset-0 w-full h-full z-0 pointer-events-none">
          <!-- Canvas que renderizará a sequência de imagens no lugar do vídeo -->
          <canvas
            id="hero-canvas"
            width="1280"
            height="720"
            class="w-full h-full object-cover opacity-90"
          ></canvas>

          <!-- Gradiente suave para garantir a legibilidade do texto -->
          <div
            class="absolute inset-0 bg-gradient-to-r from-[#EAEAE5] via-[#EAEAE5]/40 to-transparent w-full h-full"
          ></div>
        </div>

        <!-- Content Grid (Foreground) -->
        <div
          class="container mx-auto px-6 md:px-12 relative z-10 h-full flex flex-col justify-center"
        >
          <div class="grid grid-cols-12 gap-8 w-full scroll-fade-out">
            <div
              class="col-span-12 md:col-span-8 lg:col-span-6 flex flex-col justify-center"
            >
              <!-- Headline -->
              <h1
                class="font-display text-[3.5rem] md:text-7xl lg:text-[5.5rem] font-bold leading-[1.05] tracking-tighter mb-6 text-stone-900 mix-blend-darken"
              >
                <div class="overflow-hidden">
                  <div class="hero-element-text">A caneta</div>
                </div>
                <div class="overflow-hidden py-1">
                  <div class="hero-element-text outline-text">
                    mais tecnológica
                  </div>
                </div>
                <div class="overflow-hidden">
                  <div class="hero-element-text">do mundo.</div>
                </div>
              </h1>

              <!-- Paragraph -->
              <p
                class="text-lg md:text-xl text-stone-600 font-sans font-light leading-relaxed mb-10 max-w-lg hero-element text-balance"
              >
                A Artools Precision Pen redefine o equilíbrio entre peso, fluxo
                e design. Feita para criadores que exigem perfeição em cada
                traço.
              </p>

              <!-- CTAs -->
              <div class="flex flex-wrap items-center gap-4 hero-element">
                <Button variant="primary" onClick="window.location.href = '#buy'">
                  Comprar Agora
                </Button>
                <Button variant="secondary" onClick="window.location.href = '#tech-specs'">
                  Explorar
                  <iconify-icon
                    icon="solar:arrow-down-linear"
                    class="text-lg group-hover:translate-y-1 transition-transform"
                  ></iconify-icon>
                </Button>
              </div>
            </div>
          </div>

          <!-- Right Side Peripheral Marker -->
          <div
            class="absolute right-8 md:right-12 top-1/2 -translate-y-1/2 hidden lg:flex flex-col items-center gap-4 hero-element scroll-fade-out"
          >
            <span class="text-[10px] font-mono text-stone-500">01</span>
            <div class="w-[1px] h-16 bg-stone-300"></div>
          </div>

          <!-- Bottom Scroll Indicator -->
          <div
            class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-3 hero-element scroll-fade-out"
          >
            <span
              class="text-[9px] font-mono uppercase tracking-[0.2em] text-stone-400"
              >Scroll to Control</span
            >
            <div class="scroll-line"></div>
          </div>
        </div>
      </section>

      <!-- 2. SEÇÃO DE ESPECIFICAÇÕES TÉCNICAS (DESTAQUES DA CANETA) -->
      <section
        class="relative z-20 bg-stone-50 text-stone-900 py-24 md:py-32 overflow-hidden border-t border-stone-200"
        id="tech-specs"
      >
        <!-- Noise Overlay leve no fundo -->
        <div
          class="absolute inset-0 z-0 opacity-[0.03] pointer-events-none bg-[url('https://grainy-gradients.vercel.app/noise.svg')]"
        ></div>

        <div class="container mx-auto px-6 md:px-12 relative z-10">
          <!-- Marca d'água de fundo decorativa -->
          <div
            class="absolute top-0 right-0 -mr-24 -mt-24 pointer-events-none select-none opacity-[0.03] z-0 overflow-hidden hidden md:block"
          >
            <span
              class="font-display font-bold text-[15rem] leading-none text-stone-900"
              >PRECISION</span
            >
          </div>

          <!-- Cabeçalho da Seção -->
          <div class="mb-24 reveal-up relative z-10">
            <div class="inline-flex items-center gap-2 mb-6">
              <span class="w-1.5 h-1.5 bg-stone-400 rounded-full"></span>
              <span
                class="text-xs font-mono uppercase tracking-[0.2em] text-stone-400"
                >Tecnologia</span
              >
            </div>
            <h2
              class="font-display text-5xl md:text-7xl font-medium tracking-tight leading-none text-stone-900 max-w-4xl mix-blend-darken"
            >
              Engenharia Suíça.<br />
              <span class="text-stone-400">Precisão Molecular.</span>
            </h2>
            <p
              class="mt-8 text-lg text-stone-500 max-w-2xl font-light leading-relaxed text-balance"
            >
              Nossa arquitetura de fluxo proprietária sincroniza a deposição de
              tinta em tempo real. Construída sobre um chassi de alumínio
              aeroespacial usinado em CNC de 5 eixos.
            </p>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
            <!-- Visual Esquerdo (Imagem Conceitual com HUD) -->
            <div
              class="lg:col-span-7 relative group"
              style="perspective: 1000px"
            >
              <!-- Fundo deslocado para efeito 3D ao passar o mouse -->
              <div
                class="absolute inset-0 bg-stone-200/50 rounded-2xl transform rotate-2 scale-[0.98] transition-transform duration-700 group-hover:rotate-1"
              ></div>

              <!-- Container da Imagem com Animação e Efeito Hover -->
              <div
                class="relative rounded-2xl overflow-hidden aspect-[4/3] bg-stone-100 reveal-up delay-200 shadow-2xl shadow-stone-200/50 transform transition-transform duration-700 group-hover:-translate-y-2"
              >
                <!-- Efeito visual de escaneamento passando por cima da imagem -->
                <div
                  class="absolute inset-0 bg-gradient-to-b from-transparent via-white/20 to-transparent z-20 translate-y-[-100%] group-hover:translate-y-[100%] transition-transform duration-[1.5s] ease-in-out pointer-events-none"
                ></div>

                <!-- Imagem destacando as qualidades e características -->
                <img
                  src="assets/raw_files/caneta.jpeg"
                  alt="Detalhe Tecnológico da Artools"
                  class="w-full h-full object-cover grayscale contrast-110 group-hover:grayscale-0 transition-all duration-700 scale-105 group-hover:scale-100 mix-blend-multiply"
                />

                <!-- HUD Flutuante - Material e Core -->
                <div
                  class="absolute top-8 left-8 p-4 border border-white/40 rounded-lg backdrop-blur-md bg-white/30 shadow-lg text-stone-800 hover:bg-white/50 transition-colors cursor-crosshair"
                >
                  <iconify-icon
                    icon="solar:database-bold-duotone"
                    class="text-2xl text-stone-800 mb-2"
                  ></iconify-icon>
                  <div
                    class="text-[10px] font-mono text-stone-600 tracking-widest uppercase"
                  >
                    Core_Alu_6061
                  </div>
                  <div
                    class="h-0.5 w-full bg-stone-900/20 mt-2 rounded-full overflow-hidden"
                  >
                    <div class="h-full w-[80%] bg-stone-900"></div>
                  </div>
                </div>

                <!-- HUD Flutuante - Precisão da Ponta -->
                <div
                  class="absolute bottom-8 right-8 p-4 border border-white/40 rounded-lg backdrop-blur-md bg-white/30 shadow-lg text-right hover:bg-white/50 transition-colors cursor-crosshair"
                >
                  <div class="text-3xl font-display font-bold text-stone-900">
                    0.3<span
                      class="text-sm text-stone-500 font-mono align-top ml-1"
                      >mm</span
                    >
                  </div>
                  <div
                    class="text-[10px] font-mono text-stone-600 tracking-widest uppercase"
                  >
                    Tip_Precision
                  </div>
                </div>
              </div>
            </div>

            <!-- Conteúdo Direito (Lista de Qualidades) -->
            <div class="lg:col-span-5 space-y-8">
              <!-- Qualidade 01 -->
              <div
                class="reveal-up delay-300 group cursor-crosshair p-6 rounded-xl hover:bg-white hover:shadow-xl hover:shadow-stone-200/50 transition-all duration-500 border border-transparent hover:border-stone-100"
              >
                <div class="flex items-baseline gap-4 mb-3">
                  <span
                    class="text-xs font-mono text-stone-400 group-hover:text-stone-900 group-hover:scale-110 transition-all duration-300"
                    >01</span
                  >
                  <h3
                    class="text-2xl font-display font-medium text-stone-900 group-hover:translate-x-1 transition-transform duration-300"
                  >
                    Alumínio Aeroespacial
                  </h3>
                </div>
                <p
                  class="pl-8 text-stone-500 text-sm leading-relaxed group-hover:text-stone-600 transition-colors border-l border-stone-200 group-hover:border-stone-900 ml-4"
                >
                  Estrutura monobloco usinada em Alumínio 6061-T6. Leveza
                  extrema (14g) com resistência estrutural de nível militar para
                  durar a vida toda.
                </p>
              </div>

              <!-- Qualidade 02 -->
              <div
                class="reveal-up delay-500 group cursor-crosshair p-6 rounded-xl hover:bg-white hover:shadow-xl hover:shadow-stone-200/50 transition-all duration-500 border border-transparent hover:border-stone-100"
              >
                <div class="flex items-baseline gap-4 mb-3">
                  <span
                    class="text-xs font-mono text-stone-400 group-hover:text-stone-900 group-hover:scale-110 transition-all duration-300"
                    >02</span
                  >
                  <h3
                    class="text-2xl font-display font-medium text-stone-900 group-hover:translate-x-1 transition-transform duration-300"
                  >
                    Alta Precisão
                  </h3>
                </div>
                <p
                  class="pl-8 text-stone-500 text-sm leading-relaxed group-hover:text-stone-600 transition-colors border-l border-stone-200 group-hover:border-stone-900 ml-4"
                >
                  Sistema de fluxo contínuo milimetricamente ajustado, que
                  garante traços perfeitos e sem falhas, entregando uma escrita
                  cirúrgica.
                </p>
              </div>

              <!-- Qualidade 03 -->
              <div
                class="reveal-up delay-700 group cursor-crosshair p-6 rounded-xl hover:bg-white hover:shadow-xl hover:shadow-stone-200/50 transition-all duration-500 border border-transparent hover:border-stone-100"
              >
                <div class="flex items-baseline gap-4 mb-3">
                  <span
                    class="text-xs font-mono text-stone-400 group-hover:text-stone-900 group-hover:scale-110 transition-all duration-300"
                    >03</span
                  >
                  <h3
                    class="text-2xl font-display font-medium text-stone-900 group-hover:translate-x-1 transition-transform duration-300"
                  >
                    Grip Texturizado
                  </h3>
                </div>
                <p
                  class="pl-8 text-stone-500 text-sm leading-relaxed group-hover:text-stone-600 transition-colors border-l border-stone-200 group-hover:border-stone-900 ml-4"
                >
                  Micro-usinagem a laser cria uma superfície de aderência
                  perfeita (Ra 0.8µm) garantindo conforto prolongado sem
                  acumular resíduos.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 3. SEÇÃO DE EXPERIÊNCIA DE ESCRITA (FLASHLIGHT CARDS) -->
      <section
        class="relative z-20 bg-[#EAEAE5] py-24 md:py-32 overflow-hidden border-t border-stone-300"
        id="design"
      >
        <div class="max-w-[1440px] mx-auto px-6 md:px-24">
          <div class="text-center mb-24 reveal-up">
            <span
              class="text-xs font-mono uppercase tracking-[0.2em] text-stone-500 mb-6 block"
            >
              Architecture of Thought
            </span>
            <h2
              class="font-display text-5xl md:text-6xl font-medium tracking-tight text-stone-900 max-w-3xl mx-auto"
            >
              A ferramenta invisível para<br />
              <span class="text-stone-400">ideias tangíveis.</span>
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- 
              Cards de Experiência de Escrita (Flashlight Cards) instanciados via Componente.
              Transformar blocos repetitivos em componentes ajuda muito na escalabilidade, manutenção
              do código e redução de linhas no arquivo principal (index.astro).
              
              - icon: recebe o nome do ícone (usando a biblioteca Iconify).
              - title e description: conteúdo dinâmico principal do card.
              - revealDelayClass: controla o atraso em que cada card aparece ao fazer scroll (efeito "escadinha").
              - progressDelayClass: controla o atraso do carregamento da barra inferior no hover.
            -->
            <FlashlightCard 
              icon="solar:pen-new-square-linear"
              title="Fluxo Contínuo"
              description="A tinta flui sem interrupções, permitindo que seus pensamentos corram livremente para o papel sem fricção."
              revealDelayClass="delay-200"
            />

            <FlashlightCard 
              icon="solar:soundwave-square-linear"
              title="Silêncio Absoluto"
              description="Mecanismo de clique silencioso e ponta amortecida. Escreva em qualquer ambiente sem distrações."
              revealDelayClass="delay-400"
              progressDelayClass="delay-100"
            />

            <FlashlightCard 
              icon="solar:scale-linear"
              title="Equilíbrio Neutro"
              description="Centro de gravidade estudado para repousar na junção da mão, reduzindo a fadiga em 40%."
              revealDelayClass="delay-600"
              progressDelayClass="delay-200"
            />
          </div>
        </div>

        <!-- Fundo decorativo sutil -->
        <div
          class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-stone-200/50 rounded-full blur-3xl -z-10 animate-pulse pointer-events-none mix-blend-multiply"
        ></div>
      </section>

      <!-- SEÇÃO MARQUEE INFINITO (Componentizado) -->
      <Marquee />

      <!-- SEÇÃO DE ESPECIFICAÇÕES TÉCNICAS -->
       <!-- Essa seção vai ser repetir em todas páginas de canetas e componentes que será vendido -->
      <section id="tech-specs" class="bg-black py-24 relative z-20">
        <div class="container mx-auto px-6 md:px-12 max-w-4xl">
          <div class="text-center mb-16 reveal-up">
            <span class="text-xs font-mono uppercase tracking-[0.2em] text-stone-500 mb-4 block">
              Engenharia de Precisão
            </span>
            <h2 class="font-display text-4xl md:text-5xl font-medium tracking-tight text-white">
              Especificações Técnicas
            </h2>
          </div>

          <div class="bg-[#0a0a0a] border border-white/10 rounded-2xl overflow-hidden reveal-up delay-200 shadow-2xl shadow-black">
            <table class="w-full text-left border-collapse">
              <tbody>
                <tr class="border-b border-white/5 hover:bg-white/[0.02] transition-colors">
                  <th class="py-6 px-6 md:px-8 font-medium text-white w-1/3">Material do Corpo</th>
                  <td class="py-6 px-6 md:px-8 text-stone-400">Alumínio Aeroespacial 6061-T6 anodizado</td>
                </tr>
                <tr class="border-b border-white/5 hover:bg-white/[0.02] transition-colors">
                  <th class="py-6 px-6 md:px-8 font-medium text-white">Peso</th>
                  <td class="py-6 px-6 md:px-8 text-stone-400">24 gramas (balanceamento perfeito 50/50)</td>
                </tr>
                <tr class="border-b border-white/5 hover:bg-white/[0.02] transition-colors">
                  <th class="py-6 px-6 md:px-8 font-medium text-white">Comprimento</th>
                  <td class="py-6 px-6 md:px-8 text-stone-400">142 mm</td>
                </tr>
                <tr class="border-b border-white/5 hover:bg-white/[0.02] transition-colors">
                  <th class="py-6 px-6 md:px-8 font-medium text-white">Mecanismo</th>
                  <td class="py-6 px-6 md:px-8 text-stone-400">Retrátil silencioso com amortecimento a óleo</td>
                </tr>
                <tr class="border-b border-white/5 hover:bg-white/[0.02] transition-colors">
                  <th class="py-6 px-6 md:px-8 font-medium text-white">Tipo de Carga</th>
                  <td class="py-6 px-6 md:px-8 text-stone-400">Refil Schmidt P900 Parker-style (tinta gel premium inclusa)</td>
                </tr>
                <tr class="border-b border-white/5 hover:bg-white/[0.02] transition-colors">
                  <th class="py-6 px-6 md:px-8 font-medium text-white">Acabamento</th>
                  <td class="py-6 px-6 md:px-8 text-stone-400">Micro-usinagem a laser (Rugosidade de 0.8µm)</td>
                </tr>
                <tr class="hover:bg-white/[0.02] transition-colors">
                  <th class="py-6 px-6 md:px-8 font-medium text-white">Garantia</th>
                  <td class="py-6 px-6 md:px-8 text-stone-400">Vitalícia contra defeitos de fabricação</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- 4. SEÇÃO DE COMPRA / ASSINATURA -->
      <section
        class="relative min-h-screen flex items-center justify-center overflow-hidden py-24 z-20"
        id="buy"
      >
        <!-- Background Video em Loop -->
        <video
          autoplay
          loop
          muted
          playsinline
          class="absolute inset-0 w-full h-full object-cover z-0 opacity-50 mix-blend-luminosity"
        >
          <source src="assets/raw_files/video.mp4" type="video/mp4" />
        </video>

        <!-- Overlay Escuro para Legibilidade -->
        <div
          class="absolute inset-0 bg-[#111111]/70 z-10 backdrop-blur-[2px]"
        ></div>

        <div class="container mx-auto px-6 md:px-12 relative z-20">
          <div class="text-center mb-16 reveal-up">
            <span
              class="text-xs font-mono uppercase tracking-[0.2em] text-white/50 mb-4 block"
            >
              Evolua sua Escrita
            </span>
            <h2
              class="font-display text-4xl md:text-5xl font-medium tracking-tight text-white max-w-3xl mx-auto"
            >
              Escolha sua Ferramenta
            </h2>
          </div>

          <!-- Grid de Cards de Compra -->
          <div
            class="grid grid-cols-1 md:grid-cols-3 gap-8 items-center max-w-6xl mx-auto"
          >
            <!-- 
              Cards de Compra / Assinatura instanciados via Componente 
              Aqui usamos o PricingCard para renderizar os 3 planos diferentes.
              Note que o segundo card ativa a prop `isPremium` e passa um título customizado com HTML.
            -->
            <PricingCard 
              icon="solar:pen-linear"
              title="Standard Edition"
              subtitle="Apenas a Caneta"
              description="A Precision Pen original, feita em alumínio de grau aeroespacial. Perfeita para quem busca o essencial com qualidade impecável."
              price="$89"
              priceUnit="usd"
              buttonText="Comprar Agora"
              buttonHref="compra.html"
              revealDelayClass="delay-200"
            />

            <PricingCard 
              isPremium={true}
              icon="solar:crown-bold"
              title="Artools<span class='font-light'>Pro</span>"
              subtitle="Signature Series • 2026"
              buttonText="Get Early Access"
              buttonHref="compra.html"
              revealDelayClass="delay-300"
            />

            <PricingCard 
              icon="solar:infinity-bold"
              title="Creator Club"
              subtitle="Assinatura Anual"
              description="Refis de tinta ilimitados entregues na sua porta. Garantia estendida vitalícia e acesso antecipado a novos produtos da linha Artools."
              price="$29"
              priceUnit="/ano"
              buttonText="Assinar Agora"
              buttonHref="compra.html"
              revealDelayClass="delay-500"
            />
          </div>
        </div>
      </section>
    </main>

    <!-- 5. FOOTER -->
    <Footer />

    <!-- Interactions & Video Canvas Logic -->
    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        // 1. GSAP ENTRANCE ANIMATIONS
        const tl = gsap.timeline();

        // Header fade in
        tl.fromTo(
          "header",
          { y: -20, autoAlpha: 0 },
          { y: 0, autoAlpha: 1, duration: 1, ease: "power3.out" },
        );

        // Headline staggered reveal
        tl.fromTo(
          ".hero-element-text",
          { y: "110%", autoAlpha: 0 },
          {
            y: "0%",
            autoAlpha: 1,
            duration: 1.2,
            stagger: 0.15,
            ease: "power4.out",
          },
          "-=0.6",
        );

        // Paragraph, Buttons, and Peripherals reveal
        tl.fromTo(
          ".hero-element",
          { y: 20, autoAlpha: 0 },
          { y: 0, autoAlpha: 1, duration: 1, stagger: 0.1, ease: "power3.out" },
          "-=0.8",
        );

        // 2. ANIMAÇÃO DE SCROLL COM SEQUÊNCIA DE IMAGENS (MAIS EFICIENTE)
        // Esta abordagem carrega imagens invés de decodificar um vídeo real, sendo muito mais leve e fluido
        // Registramos o plugin ScrollTrigger do GSAP para atrelar a animação ao scroll
        gsap.registerPlugin(ScrollTrigger);

        const canvas = document.getElementById("hero-canvas");
        const ctx = canvas.getContext("2d", { alpha: false });

        // Configuração da sequência de imagens
        const frameCount = 192; // Quantidade total de frames (imagens) disponíveis (baseado no Exemplo)
        const currentFrame = { index: 0 }; // Objeto para armazenar o estado do frame atual que será animado pelo GSAP
        const images = []; // Array que guardará as imagens em memória

        // Função para pré-carregar as imagens
        // Isso evita travamentos durante o scroll, pois as imagens já estarão na memória RAM
        const preloadImages = () => {
          for (let i = 1; i <= frameCount; i++) {
            const img = new Image();
            // O nome dos arquivos segue o padrão frame_0001.jpg, frame_0002.jpg...
            // Usamos padStart(4, '0') para garantir que o número tenha sempre 4 dígitos
            const frameNumber = i.toString().padStart(4, "0");
            img.src = `assets/video_frames/frame_${frameNumber}.jpg`;
            images.push(img);
          }
        };

        // Função responsável por desenhar a imagem correta no canvas
        const render = () => {
          // Arredondamos o valor de index para pegar sempre um número inteiro (referente ao frame)
          const frameIndex = Math.floor(currentFrame.index);
          const img = images[frameIndex];

          if (img && img.complete) {
            // Limpamos o canvas antes de desenhar o novo frame
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // Lógica para manter a proporção (aspect ratio) da imagem ao preencher o canvas
            // Como nosso CSS usa "object-cover", o navegador lidará com a visualização,
            // desenhamos a imagem usando o tamanho 1280x720 para ter a resolução base
            ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
          }
        };

        // Iniciamos o pré-carregamento das imagens
        preloadImages();

        // Desenhamos o primeiro frame assim que ele for carregado para não deixar o canvas vazio
        if (images[0]) {
          images[0].onload = render;
        }

        // Variável de controle para não iniciar múltiplos ScrollTriggers
        let scrollInitialized = false;

        // Inicialização da animação ligada ao Scroll
        const initScrollAnimation = () => {
          if (scrollInitialized) return;
          scrollInitialized = true;

          // Criamos uma Timeline do GSAP para orquestrar múltiplas animações juntas
          let tlScroll = gsap.timeline({
            scrollTrigger: {
              trigger: "#hero-sequence", // A seção que será pinada (fixada) na tela
              start: "top top", // Inicia quando o topo da seção encosta no topo da tela
              end: "+=3500", // Distância (em pixels) que o usuário precisará dar scroll. Controla a velocidade da caneta.
              pin: true, // Fixa a tela (impede o scroll de descer a página) enquanto executamos a animação
              scrub: 1, // Aplica um "smoothing" (suavização) de 1 segundo no scroll, para a animação não ser brusca
              onUpdate: () => {
                // Sempre que houver um scroll, chamamos a função render para atualizar o frame desenhado no canvas
                // Usamos requestAnimationFrame para garantir o melhor desempenho (geralmente 60fps)
                requestAnimationFrame(render);
              },
            },
          });

          // 1. Oculta suavemente os textos e elementos (fade out) logo no início do scroll
          // Isso faz com que os elementos textuais sumam para dar destaque apenas à caneta
          tlScroll.to(
            ".scroll-fade-out",
            {
              opacity: 0,
              y: -30,
              duration: 0.15, // Duração bem curta relativa à timeline total (some rápido nos primeiros 15% do scroll)
              ease: "power2.inOut",
            },
            0,
          );

          // 2. Anima a propriedade 'index' do objeto 'currentFrame' de 0 até o último frame (frameCount - 1)
          tlScroll.to(
            currentFrame,
            {
              index: frameCount - 1,
              ease: "none", // Usamos "none" (linear) para que a velocidade do vídeo acompanhe exatamente o scroll do mouse sem acelerações
              duration: 1,
            },
            0,
          ); // O "0" indica que essa animação começa exatamente no início do scroll (junto com o fade out dos textos)
        };

        // Inicia a animação imediatamente
        initScrollAnimation();

        // 3. ANIMAÇÃO DE REVELAÇÃO DOS ELEMENTOS (REVEAL UP)
        // Esta função varre todos os elementos com a classe '.reveal-up' (Textos, Imagens, Cards)
        // e usa o ScrollTrigger para adicionar a classe 'active' quando entram na área visível da tela.
        gsap.utils.toArray(".reveal-up").forEach(function (elem) {
          ScrollTrigger.create({
            trigger: elem, // O elemento HTML que dispara a ação ao fazer o scroll
            start: "top 85%", // Ponto de partida: quando o Topo do elemento atingir 85% da altura da tela (de cima pra baixo)
            onEnter: function () {
              // A classe 'active' altera a opacidade de 0 para 1 e move o elemento no eixo Y (ver CSS)
              elem.classList.add("active");
            },
          });
        });

        // 4. FUNÇÃO DO EFEITO FLASHLIGHT
        // Esta função atualiza as variáveis CSS customizadas (--mouse-x e --mouse-y)
        // com as coordenadas exatas do mouse sobre os cards da nova seção.
        window.updateFlashlight = function (e, card) {
          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          card.style.setProperty("--mouse-x", `${x}px`);
          card.style.setProperty("--mouse-y", `${y}px`);
        };

        // 5. EFEITO DE SCROLL NO HEADER (Fundo branco para 30% transparente)
        const header = document.getElementById("main-header");
        window.addEventListener("scroll", () => {
          if (window.scrollY > 50) {
            // Quando descer (outras partes do site), fica transparente (bg-white/70) com blur
            header.classList.remove("bg-white", "py-6");
            header.classList.add(
              "bg-white/70",
              "backdrop-blur-md",
              "py-4",
              "shadow-sm",
            );
          } else {
            // No topo, volta ao fundo branco sólido
            header.classList.add("bg-white", "py-6");
            header.classList.remove(
              "bg-white/70",
              "backdrop-blur-md",
              "py-4",
              "shadow-sm",
            );
          }
        });

        // 6. SCROLLBAR CUSTOMIZADA (Sobrepõe perfeitamente os fundos)
        const customScrollbar = document.getElementById("custom-scrollbar");
        let scrollTimeout;

        function updateScrollbar() {
          const scrollHeight = document.documentElement.scrollHeight;
          const clientHeight = document.documentElement.clientHeight;
          const scrollTop = window.scrollY;

          // Se a página for menor que a tela, não precisa de scroll
          if (scrollHeight <= clientHeight) {
            customScrollbar.style.display = "none";
            return;
          } else {
            customScrollbar.style.display = "block";
          }

          // Altura do thumb
          const scrollRatio = clientHeight / scrollHeight;
          const thumbHeight = Math.max(scrollRatio * clientHeight, 40);

          // Posição Y do thumb
          const maxScrollTop = scrollHeight - clientHeight;
          const scrollProgress = scrollTop / maxScrollTop;
          const thumbTop = scrollProgress * (clientHeight - thumbHeight);

          customScrollbar.style.height = `${thumbHeight}px`;
          customScrollbar.style.transform = `translateY(${thumbTop}px)`;

          // Mostra a barra
          customScrollbar.style.opacity = "1";

          // Esconde após inatividade
          clearTimeout(scrollTimeout);
          scrollTimeout = setTimeout(() => {
            customScrollbar.style.opacity = "0";
          }, 2000);
        }

        window.addEventListener("scroll", updateScrollbar);
        window.addEventListener("resize", updateScrollbar);
        updateScrollbar();

        // Permitir arrastar a custom scrollbar com o mouse
        let isDragging = false;
        let startY;
        let startScrollTop;

        customScrollbar.addEventListener("mousedown", (e) => {
          isDragging = true;
          startY = e.clientY;
          startScrollTop = window.scrollY;
          document.body.style.userSelect = "none";
        });

        window.addEventListener("mousemove", (e) => {
          if (!isDragging) return;
          const deltaY = e.clientY - startY;
          const scrollHeight = document.documentElement.scrollHeight;
          const clientHeight = document.documentElement.clientHeight;
          const thumbHeight = Math.max(
            (clientHeight / scrollHeight) * clientHeight,
            40,
          );

          const scrollRatio =
            (scrollHeight - clientHeight) / (clientHeight - thumbHeight);
          window.scrollTo(0, startScrollTop + deltaY * scrollRatio);
        });

        window.addEventListener("mouseup", () => {
          isDragging = false;
          document.body.style.userSelect = "";
        });
      });
    </script>
  </body>
</html>
