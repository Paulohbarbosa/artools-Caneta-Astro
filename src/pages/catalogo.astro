---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import pens from '../data/products.json';
---

<Layout 
  title="Catálogo Completo | Coleção de Ferramentas de Precisão ArtTools"
  description="Explore a coleção completa de ferramentas de precisão da ArtTools. Descubra a caneta perfeitamente desenhada e balanceada para cada tipo de traço e profissional."
>
  <main class="min-h-screen bg-[#F5F5F3] pt-32 pb-24">
    <div class="container mx-auto px-6 md:px-12">
      <!-- Header do Catálogo -->
      <div class="text-center mb-16 hero-element">
        <h1 class="text-4xl md:text-5xl font-display font-bold text-stone-900 mb-6 tracking-tight">Catálogo Completo</h1>
        <p class="text-lg text-stone-500 max-w-2xl mx-auto">Explore nossa coleção completa de ferramentas de precisão. Existe uma caneta perfeita para cada tipo de traço.</p>
      </div>

      <!-- Grid de Produtos -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {pens.map((pen, index) => (
          <ProductCard 
            title={pen.name}
            description={pen.shortDescription}
            image={pen.image}
            href={`/produto/${pen.id}`}
            delay={`delay-${index * 100}`}
          />
        ))}
      </div>
    </div>
  </main>
</Layout>
