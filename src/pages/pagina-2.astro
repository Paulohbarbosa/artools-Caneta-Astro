---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="min-h-screen bg-stone-50 flex items-center justify-center p-6">
    <div class="text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-stone-900 mb-4">Página 2</h1>
      <p class="text-lg text-stone-600 mb-8">Esta é uma segunda página em branco, pronta para ser customizada.</p>
      <a href="/" class="px-6 py-3 bg-stone-900 text-white rounded-lg hover:bg-stone-800 transition-colors">Voltar para o Início</a>
    </div>
  </main>
</Layout>
