---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';

const pens = [
  {
    title: "Precision Pen Pro",
    description: "A ferramenta definitiva para engenheiros e designers com peso perfeitamente balanceado.",
    icon: "solar:pen-bold",
    image: "/assets/pens/pen_precision.jpg",
    href: "/produto",
    delay: ""
  },
  {
    title: "Signature Series V",
    description: "O toque clássico com a tecnologia do amanhã. Ideal para assinaturas e documentos importantes.",
    icon: "solar:pen-new-square-bold",
    image: "/assets/pens/pen_signature.jpg",
    href: "#",
    delay: "delay-100"
  },
  {
    title: "Minimalist Ink",
    description: "Design limpo e essencial para o seu dia a dia. Sem distrações, apenas a escrita pura.",
    icon: "solar:pen-2-bold",
    image: "/assets/pens/pen_minimalist.jpg",
    href: "#",
    delay: "delay-200"
  },
  {
    title: "Stylus Core",
    description: "Dupla funcionalidade: perfeita para telas touch e anotações rápidas em papel.",
    icon: "solar:pen-new-round-bold",
    image: "/assets/pens/pen_stylus.jpg",
    href: "#",
    delay: "delay-100"
  },
  {
    title: "Carbon Fiber Edition",
    description: "Leveza extrema e durabilidade com corpo em fibra de carbono genuína.",
    icon: "solar:box-minimalistic-bold",
    image: "/assets/pens/pen_carbon.jpg",
    href: "#",
    delay: "delay-200"
  },
  {
    title: "Titanium Write",
    description: "Resistência de grau militar para lhe acompanhar em qualquer aventura ou ambiente hostil.",
    icon: "solar:cup-star-bold",
    image: "/assets/pens/pen_titanium.jpg",
    href: "#",
    delay: "delay-300"
  },
  {
    title: "Pocket Mini",
    description: "Compacta, retrátil e prática. Cabe perfeitamente no seu bolso sem causar volume.",
    icon: "solar:tag-horizontal-bold",
    image: "/assets/pens/pen_pocket.jpg",
    href: "#",
    delay: "delay-200"
  },
  {
    title: "Calligraphy Master",
    description: "Precisão inigualável e controle de fluxo para artistas, ilustradores e calígrafos.",
    icon: "solar:document-text-bold",
    image: "/assets/pens/pen_calligraphy.jpg",
    href: "#",
    delay: "delay-300"
  },
  {
    title: "Infinite Graphite",
    description: "Escreva indefinidamente com uma ponta especial de liga metálica que dispensa refil.",
    icon: "solar:infinity-bold",
    image: "/assets/pens/pen_infinite.jpg",
    href: "#",
    delay: "delay-500"
  }
];
---

<Layout title="Catálogo de Canetas - Artools">
  <main class="min-h-screen bg-[#F5F5F3] pt-32 pb-24">
    <div class="container mx-auto px-6 md:px-12">
      <!-- Header do Catálogo -->
      <div class="text-center mb-16 hero-element">
        <h1 class="text-4xl md:text-5xl font-display font-bold text-stone-900 mb-6 tracking-tight">Catálogo Completo</h1>
        <p class="text-lg text-stone-500 max-w-2xl mx-auto">Explore nossa coleção completa de ferramentas de precisão. Existe uma caneta perfeita para cada tipo de traço.</p>
      </div>

      <!-- Grid de Produtos -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {pens.map((pen) => (
          <ProductCard 
            title={pen.title}
            description={pen.description}
            icon={pen.icon}
            image={pen.image}
            href={pen.href}
            delay={pen.delay}
          />
        ))}
      </div>
    </div>
  </main>
</Layout>
