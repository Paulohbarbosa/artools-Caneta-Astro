---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import TechSpecs from '../../components/TechSpecs.astro';
import productsData from '../../data/products.json';

export function getStaticPaths() {
  return productsData.map((product) => {
    return {
      params: { id: product.id },
      props: { product },
    };
  });
}

const { product } = Astro.props;
---

<Layout title={`${product.name} - Detalhes do Produto`}>
  <main class="min-h-screen bg-[#F5F5F3] pt-32 pb-24">
    <div class="container mx-auto px-6 md:px-12">
      
      <!-- Breadcrumb simples -->
      <nav class="mb-8 text-sm font-mono uppercase tracking-widest text-stone-500 reveal-up">
        <a href="/" class="hover:text-stone-900 transition-colors">Início</a> 
        <span class="mx-2">/</span>
        <a href="/catalogo" class="hover:text-stone-900 transition-colors">Catálogo</a>
        <span class="mx-2">/</span>
        <span class="text-stone-900">{product.name}</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        
        <!-- Galeria / Imagem Principal -->
        <div class="reveal-up rounded-2xl overflow-hidden bg-white shadow-xl shadow-stone-200/50 p-8 flex items-center justify-center">
          <img 
            src={product.image}
            alt={product.name} 
            class="w-full h-auto object-cover hover:scale-105 transition-transform duration-700 rounded-xl"
          />
        </div>

        <!-- Detalhes do Produto -->
        <div class="reveal-up delay-100 flex flex-col justify-center">
          
          <div class="mb-6">
            <span class="inline-block px-3 py-1 bg-stone-200 text-stone-600 text-xs font-bold font-mono tracking-widest rounded-full mb-4">{product.status}</span>
            <h1 class="text-4xl md:text-5xl font-display font-bold text-stone-900 mb-4 tracking-tight">{product.name}</h1>
            <p class="text-2xl font-mono text-stone-500 mb-6"><span class="text-stone-400 text-xl">R$</span> {product.price},00</p>
          </div>

          <p class="text-lg text-stone-600 leading-relaxed mb-8">
            {product.shortDescription}
          </p>

          <!-- Features (Bullet points com ícones) -->
          <ul class="space-y-4 mb-10 text-stone-600">
            {product.features.map((feature) => (
                  <li class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full bg-stone-200 flex items-center justify-center text-stone-900">
                      <iconify-icon icon="solar:check-circle-bold"></iconify-icon>
                    </div>
                    {feature}
                  </li>
                ))}
          </ul>

          <!-- Seção de "Avise-me" -->
          <div class="bg-white p-6 rounded-xl border border-stone-200 shadow-sm">
            <h3 class="text-lg font-display font-bold text-stone-900 mb-2">Este produto está atualmente sem estoque.</h3>
            <p class="text-sm text-stone-500 mb-6">Deixe seu email abaixo e seja o primeiro a saber quando o novo lote estiver disponível. Não enviamos spam.</p>
            
            <form class="flex flex-col sm:flex-row gap-3" onsubmit="event.preventDefault(); alert('E-mail cadastrado com sucesso!');">
              <input 
                type="email" 
                placeholder="Seu melhor e-mail" 
                required
                class="flex-1 px-4 py-3 bg-stone-50 border border-stone-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-stone-900 focus:border-transparent transition-all"
              />
              <Button variant="primary" class="whitespace-nowrap">
                Avise-me <iconify-icon icon="solar:bell-bold" class="text-lg ml-1"></iconify-icon>
              </Button>
            </form>
          </div>

        </div>
      </div>

      <!-- Informações do Produto (Inspirado na Imagem de Referência) -->
      <section class="mt-24 mb-24 reveal-up">
        <div class="text-center mb-16">
          <span class="text-sm font-mono uppercase tracking-widest text-stone-500 mb-2">{product.productInfo.subtitle}</span>
          <h2 class="text-4xl md:text-5xl font-display font-bold text-stone-900 mb-2">
            {product.name.split(' ')[0]} <span class="text-stone-400 italic">{product.name.split(' ')[1]}</span>
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
          <!-- Feature 1 -->
           {(Array.isArray(product.productInfo) ? product.productInfo : product.productInfo.details).map (info => (
            <div class="flex flex-col group">
            <div class="w-full aspect-square bg-stone-200 rounded-2xl mb-6 overflow-hidden flex items-center justify-center relative">
               {'image' in info && info.image ? (
                 <img src={info.image} alt={info.title} class="w-full h-full object-cover" />
               ) : (
                 <iconify-icon icon={'icon' in info ? info.icon : "solar:box-broken"} class="text-6xl text-stone-400"></iconify-icon>
               )}
            </div>
            <h3 class="text-xl font-display font-bold text-stone-900 mb-3">{info.title}</h3>
            <p class="text-stone-600 leading-relaxed text-sm">{info.description}</p>
          </div>

           ))}
        </div>
      </section>

       <!-- Ficha Técnica (TechSpecs) -->
      <div class="mt-24 mb-16">
        <TechSpecs specs={product.techSpecs} />
      </div>

      <!-- Avaliações dos Clientes -->
      <section class="mt-24 mb-16 reveal-up">
        <div class="flex justify-between items-center">
        <h2 class="text-3xl font-display font-bold text-stone-900 mb-8 text-center md:text-left">Avaliações dos Clientes <span class="text-stone-400 italic">{(product.reviews.reduce((acc, review) => acc + review.rating, 0) / product.reviews.length).toFixed(1)} / 5</span></h2>
        <a href="#" class="text-sm text-stone-500 mb-6 md:text-left text-center">Mais Avaliações ({product.reviews.length})</a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          
          <!-- Avaliações somente 3 primeiros reviews-->
           {product.reviews.slice(0, 3).map(review => (
            <div class="bg-white p-6 rounded-xl border border-stone-200 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-center gap-1 mb-4 text-lg">
              {
                Array.from({ length: 5 }).map((_, index) => (
                  <iconify-icon 
                    icon="solar:star-bold" 
                    class={index < review.rating ? "text-yellow-500" : "text-stone-200"}
                  ></iconify-icon>
                ))
              }
            </div>
            <p class="text-stone-600 mb-4 italic leading-relaxed">{review.comment}</p>
            <p class="font-bold text-sm text-stone-900 tracking-wide uppercase font-mono">- {review.author}, {review.role}</p>
          </div>
           ))}
        </div>
      </section>
      
    </div>
  </main>
</Layout>
