---
// src/pages/compra.astro
import '../styles/global.css';
---
<!doctype html>
<html class="scroll-smooth" lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Checkout - Artools Precision Pen</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Iconify & GSAP -->
    <script is:inline src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

    <!-- Custom Tailwind Configuration needed for Checkout -->
    <style is:global>
      :root {
        --bg-color: #eaeae5;
        --text-main: #1c1917;
      }

      body {
        font-family: "Inter", sans-serif;
        background-color: var(--bg-color);
        color: var(--text-main);
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
      }

      /* Oculta scrollbar nativa */
      ::-webkit-scrollbar {
        display: none;
      }
      html {
        scrollbar-width: none;
      }

      /* Custom Input & Floating Labels */
      .input-group {
        position: relative;
        width: 100%;
      }

      .floating-input {
        width: 100%;
        padding: 1.5rem 1rem 0.5rem 1rem;
        background: rgba(0, 0, 0, 0.03);
        border: 1px solid rgba(0, 0, 0, 0.1);
        border-radius: 0.75rem;
        color: var(--text-main);
        outline: none;
        transition: all 0.3s ease;
        font-size: 0.875rem;
      }

      .floating-input:focus {
        border-color: rgba(0, 0, 0, 0.3);
        background: rgba(0, 0, 0, 0.05);
        box-shadow: 0 0 15px rgba(0, 0, 0, 0.05);
      }

      .floating-label {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: #78716c;
        pointer-events: none;
        transition: all 0.3s ease;
        font-size: 0.875rem;
      }

      .floating-input:focus ~ .floating-label,
      .floating-input:not(:placeholder-shown) ~ .floating-label {
        top: 0.75rem;
        font-size: 0.65rem;
        color: #57534e;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      /* Glassmorphism utils */
      .glass-panel {
        background: rgba(255, 255, 255, 0.4);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.5);
      }

      /* Animações de Revelação */
      .reveal-up {
        opacity: 0;
        transform: translateY(20px);
        will-change: transform, opacity;
        transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .reveal-up.active {
        opacity: 1;
        transform: translateY(0);
      }

      /* Background animado */
      .bg-glow {
        position: fixed;
        top: 50%;
        left: 50%;
        width: 100vw;
        height: 100vh;
        transform: translate(-50%, -50%);
        background: radial-gradient(
          circle at 50% 50%,
          rgba(255, 255, 255, 0.4) 0%,
          transparent 60%
        );
        z-index: -2;
        pointer-events: none;
      }

      .bg-noise {
        position: fixed;
        inset: 0;
        z-index: -1;
        opacity: 0.03;
        pointer-events: none;
        background-image: url('data:image/svg+xml,%3Csvg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg"%3E%3Cfilter id="noiseFilter"%3E%3CfeTurbulence type="fractalNoise" baseFrequency="0.65" numOctaves="3" stitchTiles="stitch"/%3E%3C/filter%3E%3Crect width="100%25" height="100%25" filter="url(%23noiseFilter)"/%3E%3C/svg%3E');
      }
    </style>
  </head>
  <body class="relative text-stone-700 font-sans">
    <!-- BG Elements -->
    <div class="bg-glow"></div>
    <div class="bg-noise"></div>

    <div
      id="custom-scrollbar"
      class="fixed right-[5px] top-0 w-[6px] bg-stone-400/50 hover:bg-stone-400/80 rounded-full z-[9999] transition-opacity duration-300 opacity-0 pointer-events-auto cursor-pointer"
    ></div>

    <!-- MAIN APP CONTAINER -->
    <div id="checkout-container" class="min-h-screen flex flex-col transition-opacity duration-800">
      <!-- HEADER MINIMAL -->
      <header
        class="w-full z-50 px-6 md:px-12 py-4 flex flex-col md:flex-row justify-between items-center glass-panel border-b border-black/5 sticky top-0"
      >
        <div class="flex items-center justify-between w-full md:w-auto mb-4 md:mb-0">
          <a href="/" class="flex items-center gap-3 text-stone-900 hover:opacity-80 transition-opacity">
            <div class="w-6 h-6 bg-stone-900 text-white flex items-center justify-center rounded-sm">
              <iconify-icon icon="solar:pen-bold" class="text-sm"></iconify-icon>
            </div>
            <span class="font-display font-bold tracking-tight text-lg">
              ARTOOLS<span class="text-stone-500 font-light">.PRO</span>
            </span>
          </a>

          <button class="md:hidden text-stone-900 relative">
            <iconify-icon icon="solar:cart-large-minimalistic-linear" class="text-xl"></iconify-icon>
            <span id="mobile-cart-count" class="absolute -top-1 -right-2 bg-stone-900 text-white text-[9px] font-bold w-4 h-4 rounded-full flex items-center justify-center">0</span>
          </button>
        </div>

        <div class="flex items-center gap-4 text-[10px] font-mono uppercase tracking-[0.15em] text-stone-400">
          <span class="text-stone-900">Checkout</span>
          <iconify-icon icon="solar:alt-arrow-right-linear"></iconify-icon>
          <span>Pagamento</span>
        </div>

        <div class="hidden md:flex items-center gap-4">
          <div class="text-xs font-mono text-stone-500">
            Total: <span id="header-total" class="text-stone-900">$0.00</span>
          </div>
          <iconify-icon icon="solar:lock-password-linear" class="text-stone-400"></iconify-icon>
        </div>
      </header>

      <!-- MAIN GRID -->
      <main class="flex-grow container mx-auto px-6 md:px-12 py-12 md:py-20 flex justify-center">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 w-full max-w-6xl relative">
          <!-- COLUNA ESQUERDA: FORMS -->
          <div class="lg:col-span-7 space-y-12">
            <!-- Login Rápido -->
            <div class="glass-panel rounded-2xl p-8 reveal-up">
              <div class="flex items-center justify-between mb-6">
                <h2 class="text-xl font-display text-stone-900">Já possui conta?</h2>
                <button class="text-xs font-mono uppercase tracking-widest text-stone-500 hover:text-stone-900 transition-colors border-b border-stone-300 hover:border-stone-900 pb-1">
                  Fazer Login
                </button>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <button class="flex items-center justify-center gap-3 w-full py-3.5 px-4 bg-black/5 hover:bg-black/10 border border-black/10 rounded-xl transition-all text-sm font-medium">
                  <iconify-icon icon="flat-color-icons:google" class="text-lg"></iconify-icon> Google
                </button>
                <button class="flex items-center justify-center gap-3 w-full py-3.5 px-4 bg-black/5 hover:bg-black/10 border border-black/10 rounded-xl transition-all text-sm font-medium">
                  <iconify-icon icon="ic:baseline-apple" class="text-xl text-stone-900"></iconify-icon> Apple
                </button>
              </div>
            </div>

            <!-- Identificação e Entrega -->
            <div class="reveal-up">
              <h2 class="text-2xl font-display text-stone-900 mb-2">Identificação & Entrega</h2>
              <p class="text-stone-600 text-sm mb-8">Finalize sua experiência Artools preenchendo os dados abaixo.</p>

              <div class="glass-panel rounded-2xl p-8 space-y-8">
                <!-- Dados Pessoais -->
                <div class="space-y-4">
                  <h3 class="text-xs font-mono uppercase tracking-[0.2em] text-stone-500 border-b border-black/10 pb-2 mb-4">Dados Pessoais</h3>
                  <div class="input-group">
                    <input type="text" id="nome" class="floating-input" placeholder=" " required />
                    <label for="nome" class="floating-label">Nome Completo</label>
                  </div>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="input-group">
                      <input type="email" id="email" class="floating-input" placeholder=" " required />
                      <label for="email" class="floating-label">E-mail</label>
                    </div>
                    <div class="input-group">
                      <input type="tel" id="telefone" class="floating-input" placeholder=" " required />
                      <label for="telefone" class="floating-label">Telefone</label>
                    </div>
                  </div>
                </div>

                <!-- Endereço -->
                <div class="space-y-4">
                  <h3 class="text-xs font-mono uppercase tracking-[0.2em] text-stone-500 border-b border-black/10 pb-2 mb-4 mt-8">Endereço de Entrega</h3>
                  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="input-group md:col-span-1">
                      <input type="text" id="cep" class="floating-input" placeholder=" " required />
                      <label for="cep" class="floating-label">CEP</label>
                    </div>
                    <div class="input-group md:col-span-2">
                      <input type="text" id="endereco" class="floating-input" placeholder=" " required />
                      <label for="endereco" class="floating-label">Endereço</label>
                    </div>
                  </div>
                  <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                    <div class="input-group md:col-span-1">
                      <input type="text" id="numero" class="floating-input" placeholder=" " required />
                      <label for="numero" class="floating-label">Número</label>
                    </div>
                    <div class="input-group md:col-span-3">
                      <input type="text" id="complemento" class="floating-input" placeholder=" " />
                      <label for="complemento" class="floating-label">Complemento (opcional)</label>
                    </div>
                  </div>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="input-group">
                      <input type="text" id="cidade" class="floating-input" placeholder=" " required />
                      <label for="cidade" class="floating-label">Cidade</label>
                    </div>
                    <div class="input-group">
                      <input type="text" id="estado" class="floating-input" placeholder=" " required />
                      <label for="estado" class="floating-label">Estado / Província</label>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- COLUNA DIREITA: STICKY SUMMARY -->
          <div class="lg:col-span-5 relative">
            <div class="sticky top-32 glass-panel rounded-3xl p-8 reveal-up delay-200">
              <h2 class="text-lg font-display text-stone-900 mb-6 border-b border-black/10 pb-4">Resumo do Pedido</h2>

              <div id="cart-items-container" class="mb-8 space-y-4 max-h-[300px] overflow-y-auto pr-2">
                <!-- Items listados dinamicamente via JS -->
              </div>

              <!-- Cupom -->
              <div class="flex gap-2 mb-8 border-b border-black/10 pb-8">
                <input type="text" placeholder="Código promocional" class="flex-grow bg-black/5 border border-black/10 rounded-lg px-4 py-3 text-sm text-stone-900 outline-none focus:border-black/30 transition-colors" />
                <button class="bg-black/5 hover:bg-black/10 text-stone-900 px-4 py-3 rounded-lg text-sm font-medium transition-colors border border-black/10">Aplicar</button>
              </div>

              <!-- Valores -->
              <div class="space-y-3 text-sm mb-8">
                <div class="flex justify-between text-stone-500">
                  <span>Subtotal</span>
                  <span id="summary-subtotal" class="text-stone-900">$0.00</span>
                </div>
                <div class="flex justify-between text-stone-500">
                  <span>Frete Expansivo</span>
                  <span class="text-stone-900">Grátis</span>
                </div>
                <div class="flex justify-between font-display text-xl text-stone-900 pt-4 border-t border-black/5 mt-4">
                  <span>Total</span>
                  <span><span id="summary-total">$0.00</span> <span class="text-xs font-mono text-stone-400 uppercase">usd</span></span>
                </div>
              </div>

              <!-- CTA -->
              <button id="checkout-button" class="w-full py-4 px-6 bg-stone-900 text-white rounded-full text-sm font-medium hover:bg-stone-800 hover:scale-[1.02] hover:shadow-[0_0_20px_rgba(0,0,0,0.2)] transition-all flex items-center justify-center gap-2 group mb-6">
                Finalizar Compra
                <iconify-icon icon="solar:arrow-right-linear" class="text-lg group-hover:translate-x-1 transition-transform"></iconify-icon>
              </button>

              <!-- Segurança -->
              <div class="grid grid-cols-3 gap-2 pt-6 border-t border-black/5 text-center">
                <div class="flex flex-col items-center gap-2 text-stone-400">
                  <iconify-icon icon="solar:shield-check-linear" class="text-xl text-stone-500"></iconify-icon>
                  <span class="text-[9px] uppercase tracking-wider text-stone-500">Compra Segura</span>
                </div>
                <div class="flex flex-col items-center gap-2 text-stone-400">
                  <iconify-icon icon="solar:box-minimalistic-linear" class="text-xl text-stone-500"></iconify-icon>
                  <span class="text-[9px] uppercase tracking-wider text-stone-500">Frete Rastreado</span>
                </div>
                <div class="flex flex-col items-center gap-2 text-stone-400">
                  <iconify-icon icon="solar:medal-star-linear" class="text-xl text-stone-500"></iconify-icon>
                  <span class="text-[9px] uppercase tracking-wider text-stone-500">Garantia Vitalícia</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>

    <!-- TELA DE SUCESSO -->
    <div id="success-screen" style="display: none" class="fixed inset-0 z-50 flex items-center justify-center bg-stone-950 overflow-hidden">
      <video autoplay loop muted playsinline class="absolute inset-0 w-full h-full object-cover z-0 opacity-50 scale-105">
        <source src="/assets/raw_files/video.mp4" type="video/mp4" />
      </video>
      <div class="absolute inset-0 bg-stone-950/60 z-0 backdrop-blur-sm"></div>

      <div class="text-center z-10 p-6 success-content opacity-0 translate-y-10">
        <div class="w-20 h-20 bg-white text-stone-900 rounded-full flex items-center justify-center mx-auto mb-8 shadow-[0_0_40px_rgba(255,255,255,0.2)]">
          <iconify-icon icon="solar:check-read-linear" class="text-4xl"></iconify-icon>
        </div>
        <h1 class="font-display text-5xl md:text-7xl font-bold tracking-tighter text-white mb-4">Tecnologia enviada.</h1>
        <p class="text-xl text-stone-300 font-light mb-12">Sua Artools está a caminho.</p>

        <div class="glass-panel p-6 rounded-2xl max-w-sm mx-auto mb-10 text-left border-white/10 bg-white/5 backdrop-blur-xl">
          <div class="text-[10px] font-mono text-stone-400 uppercase tracking-widest mb-1">Pedido #AR-2026-892</div>
          <div class="text-white text-sm mb-4">Confirmado</div>
          <div class="h-[1px] w-full bg-white/10 mb-4"></div>
          <div class="flex justify-between items-center text-sm">
            <span class="text-stone-400">Rastreamento:</span>
            <a href="/" class="text-white hover:underline flex items-center gap-1">Acompanhar <iconify-icon icon="solar:arrow-right-up-linear"></iconify-icon></a>
          </div>
        </div>

        <a href="/" class="inline-block py-3 px-8 border border-white/20 text-white rounded-full text-sm hover:bg-white hover:text-stone-900 transition-colors">
          Voltar à página inicial
        </a>
      </div>
    </div>

    <script>
      import { cartItems, removeCartItem } from '../store/cartStore';
      import type { CartItem } from '../store/cartStore';

      declare const gsap: any;
      declare const ScrollTrigger: any;

      // Attach remove to window so it can be called from injected HTML
      // @ts-ignore
      window.removeCartItem = removeCartItem;

      document.addEventListener("DOMContentLoaded", () => {
        gsap.registerPlugin(ScrollTrigger);
        gsap.utils.toArray(".reveal-up").forEach(function (elem: any) {
          ScrollTrigger.create({
            trigger: elem,
            start: "top 90%",
            onEnter: function () {
              elem.classList.add("active");
            },
          });
        });

        const customScrollbar = document.getElementById("custom-scrollbar");
        let scrollTimeout: number | undefined;

        function updateScrollbar() {
          if (!customScrollbar) return;
          const scrollHeight = document.documentElement.scrollHeight;
          const clientHeight = document.documentElement.clientHeight;
          const scrollTop = window.scrollY;

          if (scrollHeight <= clientHeight) {
            customScrollbar.style.display = "none";
            return;
          } else {
            customScrollbar.style.display = "block";
          }

          const scrollRatio = clientHeight / scrollHeight;
          const thumbHeight = Math.max(scrollRatio * clientHeight, 40);
          const maxScrollTop = scrollHeight - clientHeight;
          const scrollProgress = scrollTop / maxScrollTop;
          const thumbTop = scrollProgress * (clientHeight - thumbHeight);

          customScrollbar.style.height = `${thumbHeight}px`;
          customScrollbar.style.transform = `translateY(${thumbTop}px)`;
          customScrollbar.style.opacity = "1";

          clearTimeout(scrollTimeout);
          scrollTimeout = setTimeout(() => {
            customScrollbar.style.opacity = "0";
          }, 2000) as unknown as number;
        }

        window.addEventListener("scroll", updateScrollbar);
        window.addEventListener("resize", updateScrollbar);
        updateScrollbar();

        // Cart Syncing Logic
        const cartContainer = document.getElementById('cart-items-container');
        const summaryTotal = document.getElementById('summary-total');
        const summarySubtotal = document.getElementById('summary-subtotal');
        const headerTotal = document.getElementById('header-total');
        const mobileCartCount = document.getElementById('mobile-cart-count');

        const updateUI = (cart: Record<string, CartItem>) => {
          const items = Object.values(cart);
          
          if (!cartContainer) return;
          
          if (items.length === 0) {
            cartContainer.innerHTML = '<p class="text-sm text-stone-500">Seu carrinho está vazio.</p>';
            if (summaryTotal) summaryTotal.textContent = '$0.00';
            if (summarySubtotal) summarySubtotal.textContent = '$0.00';
            if (headerTotal) headerTotal.textContent = '$0.00';
            if (mobileCartCount) mobileCartCount.textContent = '0';
            return;
          }

          let total = 0;
          let count = 0;
          cartContainer.innerHTML = items.map((item: CartItem) => {
            total += item.price * item.quantity;
            count += item.quantity;
            return `
              <div class="flex items-center gap-4 border-b border-black/5 pb-4 last:border-0 last:pb-0">
                <div class="w-16 h-20 bg-stone-100 rounded-lg border border-black/5 overflow-hidden flex items-center justify-center relative shrink-0">
                  <img src="${item.image || '/assets/raw_files/caneta.jpeg'}" alt="${item.name}" class="w-full h-full object-cover" />
                </div>
                <div class="flex-grow">
                  <h3 class="text-stone-900 font-medium text-sm mb-1">${item.name}</h3>
                  <p class="text-sm font-medium text-stone-900">
                    <samp style="color: gray">${item.quantity} x </samp>$${item.price.toFixed(2)}
                  </p>
                </div>
                <button onclick="window.removeCartItem('${item.id}')" class="text-stone-400 hover:text-red-500 transition-colors p-2 shrink-0">
                  <iconify-icon icon="solar:trash-bin-trash-linear" class="text-lg"></iconify-icon>
                </button>
              </div>
            `;
          }).join('');

          if (summaryTotal) summaryTotal.textContent = `$${total.toFixed(2)}`;
          if (summarySubtotal) summarySubtotal.textContent = `$${total.toFixed(2)}`;
          if (headerTotal) headerTotal.textContent = `$${total.toFixed(2)}`;
          if (mobileCartCount) mobileCartCount.textContent = count.toString();
        };

        // Subscribe to store changes
        cartItems.subscribe(updateUI as any);

        // Checkout Button Logic
        const checkoutBtn = document.getElementById('checkout-button');
        const container = document.getElementById('checkout-container');
        const successScreen = document.getElementById('success-screen');

        if (checkoutBtn) {
          checkoutBtn.addEventListener('click', () => {
            const items = Object.values(cartItems.get());
            if (items.length === 0) {
              alert("Seu carrinho está vazio!");
              return;
            }

            if (container) container.style.display = 'none';
            if (successScreen) {
              successScreen.style.display = 'flex';
              
              // Clear cart after success
              cartItems.set({});

              setTimeout(() => {
                gsap.to(".success-content", {
                  opacity: 1,
                  y: 0,
                  duration: 1.2,
                  ease: "power4.out",
                });
              }, 50);
            }
          });
        }
      });
    </script>
  </body>
</html>
